# Copy to .env and replace every value marked "change me". .env is ignored by git.

ENVIRONMENT=development

# Used by Docker Compose. Compose builds DATABASE_URL and REDIS_URL from these.
POSTGRES_USER=incident
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=incidents

# Needed when running without Docker (see docs/LOCAL_SETUP.md).
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
# REDIS_URL=redis://127.0.0.1:6380/0

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-at-least-32-random-characters
# Protects GET /metrics. Leave unset to disable the endpoint.
METRICS_TOKEN=
# Password for all synthetic demo accounts, 12 characters or more.
DEMO_PASSWORD=change-me-demo-password

# Set both to true/production behind HTTPS.
COOKIE_SECURE=false

# LLM: extractive needs no model and is the default.
LLM_PROVIDER=extractive
# Local Ollama:   LLM_PROVIDER=ollama             LLM_BASE_URL=http://host.docker.internal:11434  LLM_MODEL=phi3:mini
# Hosted service: LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://api.example.com/v1          LLM_MODEL=model-name  LLM_API_KEY=...
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Email for notifications. In-app notifications work without this.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=incidents@example.com
